<%@ page contentType="text/html;charset=UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %>
<c:set var="pageTitle" value="${profileMode ? 'My Profile' : 'Customer Details'}" scope="request"/><jsp:include page="/WEB-INF/views/common/header.jsp"/>
<div class="page-actions"><div><h1 class="page-heading"><c:out value="${customer.fullName}"/></h1><p><c:out value="${customer.customerCode}"/> · Registered <c:out value="${customer.registrationDate.toLocalDate()}"/></p></div><div class="d-flex gap-2"><c:if test="${!profileMode}"><a class="btn btn-outline-primary" href="${pageContext.request.contextPath}/customers/edit?id=${customer.id}"><i class="bi bi-pencil"></i> Edit</a></c:if><a class="btn btn-light" href="${profileMode ? pageContext.request.contextPath.concat('/dashboard') : pageContext.request.contextPath.concat('/customers/')}">Back</a></div></div>
<div class="row g-4 mb-4"><div class="col-lg-4"><div class="panel h-100"><div class="profile-head"><div class="profile-avatar"><c:out value="${customer.fullName.substring(0,1)}"/></div><h2><c:out value="${customer.fullName}"/></h2><span class="status-badge" data-status="${customer.accountStatus}"><c:out value="${customer.accountStatus}"/></span></div><dl class="detail-list"><dt>Email</dt><dd><c:out value="${customer.email}"/></dd><dt>Phone</dt><dd><c:out value="${customer.phone}"/></dd><dt>Address</dt><dd><c:out value="${customer.address}"/></dd></dl></div></div>
<div class="col-lg-8"><div class="panel h-100"><div class="panel-header"><h2>Previous laundry orders</h2><c:if test="${!profileMode}"><a href="${pageContext.request.contextPath}/orders/new">Create order</a></c:if></div><c:choose><c:when test="${empty orders}"><div class="empty-state"><i class="bi bi-basket"></i><p>No orders found for this customer.</p></div></c:when><c:otherwise><div class="table-responsive"><table class="table align-middle"><thead><tr><th>Order</th><th>Date</th><th>Status</th><th>Total</th><th></th></tr></thead><tbody><c:forEach items="${orders}" var="order"><tr><td><strong><c:out value="${order.orderNumber}"/></strong></td><td><c:out value="${order.receivedAt.toLocalDate()}"/></td><td><span class="status-badge" data-status="${order.status}"><c:out value="${order.status}"/></span></td><td>LKR <fmt:formatNumber value="${order.totalAmount}" minFractionDigits="2"/></td><td><a class="btn btn-sm btn-light" href="${pageContext.request.contextPath}/orders/view?id=${order.id}">View</a></td></tr></c:forEach></tbody></table></div></c:otherwise></c:choose></div></div></div>
<jsp:include page="/WEB-INF/views/common/footer.jsp"/>
