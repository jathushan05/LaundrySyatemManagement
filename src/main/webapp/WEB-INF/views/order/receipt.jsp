<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %>
<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width"><title>Receipt <c:out value="${order.orderNumber}"/></title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"><link href="${pageContext.request.contextPath}/assets/css/app.css" rel="stylesheet"></head><body class="receipt-page"><main class="receipt"><div class="receipt-actions d-print-none"><a class="btn btn-light" href="${pageContext.request.contextPath}/orders/view?id=${order.id}">Back</a><button class="btn btn-primary" onclick="window.print()">Print receipt</button></div><header><div><div class="receipt-logo">AquaClean</div><p>Professional Laundry Services</p></div><div class="text-end"><h1>RECEIPT</h1><strong><c:out value="${order.orderNumber}"/></strong></div></header><section class="receipt-meta"><div><small>BILLED TO</small><strong><c:out value="${order.customerName}"/></strong></div><div><small>RECEIVED</small><strong><c:out value="${order.receivedAt.toLocalDate()}"/></strong></div><div><small>STATUS</small><strong><c:out value="${order.status}"/></strong></div></section><table class="table"><thead><tr><th>Description</th><th>Service</th><th class="text-end">Qty</th><th class="text-end">Price</th><th class="text-end">Amount</th></tr></thead><tbody><c:forEach items="${order.items}" var="item"><tr><td><c:out value="${item.itemName}"/></td><td><c:out value="${item.serviceName}"/></td><td class="text-end">${item.quantity}</td><td class="text-end"><fmt:formatNumber value="${item.unitPrice}" minFractionDigits="2"/></td><td class="text-end"><fmt:formatNumber value="${item.subtotal}" minFractionDigits="2"/></td></tr></c:forEach></tbody></table><div class="receipt-total"><span>Total</span><strong>LKR <fmt:formatNumber value="${order.totalAmount}" minFractionDigits="2"/></strong></div><footer>Thank you for choosing AquaClean. Please retain this receipt for reference.</footer></main></body></html>
