<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<c:set var="editing" value="${not empty feedback.id}"/><c:set var="pageTitle" value="${editing?'Edit Feedback':'Write a Review'}" scope="request"/><jsp:include page="/WEB-INF/views/common/header.jsp"/>
<div class="page-actions"><div><h1 class="page-heading"><c:out value="${pageTitle}"/></h1><p>You can review a completed order once. Edits are allowed for 7 days.</p></div><a class="btn btn-light" href="${pageContext.request.contextPath}/feedback/">Back</a></div>
<div class="panel form-panel review-form"><form method="post" action="${pageContext.request.contextPath}/feedback/" class="needs-validation" novalidate><input type="hidden" name="csrfToken" value="<c:out value='${sessionScope.csrfToken}'/>"><input type="hidden" name="action" value="${editing?'update':'create'}"><c:if test="${editing}"><input type="hidden" name="id" value="${feedback.id}"></c:if>
<c:choose><c:when test="${!editing && empty eligibleOrders}"><div class="empty-state"><i class="bi bi-check2-circle"></i><h3>No order is ready for review</h3><p>Feedback becomes available after an order is completed or delivered, and only one review is allowed per order.</p><a class="btn btn-primary" href="${pageContext.request.contextPath}/orders/">View my orders</a></div></c:when><c:otherwise><c:if test="${!editing}"><div class="mb-4"><label class="form-label">Completed order *</label><select class="form-select" name="orderId" required><option value="">Select an order</option><c:forEach items="${eligibleOrders}" var="order"><option value="${order.id}"><c:out value="${order.orderNumber}"/> — LKR <c:out value="${order.totalAmount}"/></option></c:forEach></select></div></c:if><div class="mb-4"><label class="form-label d-block">Your rating *</label><div class="star-picker" data-rating="${empty feedback.rating?0:feedback.rating}"><c:forEach begin="1" end="5" var="star"><button type="button" data-value="${star}" aria-label="${star} stars"><i class="bi bi-star-fill"></i></button></c:forEach><input type="hidden" name="rating" value="${feedback.rating}" required></div></div><div class="mb-3"><label class="form-label">Review comment *</label><textarea class="form-control" name="comment" rows="6" minlength="5" maxlength="1000" required placeholder="Tell us what went well or what we can improve."><c:out value="${feedback.comment}"/></textarea><div class="form-text"><span data-char-count>0</span>/1000 characters</div></div><div class="form-actions"><a class="btn btn-light" href="${pageContext.request.contextPath}/feedback/">Cancel</a><button class="btn btn-primary">${editing?'Save changes':'Submit review'}</button></div></c:otherwise></c:choose></form></div>
<jsp:include page="/WEB-INF/views/common/footer.jsp"/>
