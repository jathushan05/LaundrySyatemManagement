<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %>
<c:set var="pageTitle" value="Feedback & Reviews" scope="request"/><jsp:include page="/WEB-INF/views/common/header.jsp"/>
<div class="page-actions"><div><h1 class="page-heading">Feedback & reviews</h1><p>${sessionScope.role=='CUSTOMER'?'Share and manage your order experiences.':'Moderate reviews and understand customer satisfaction.'}</p></div><c:if test="${sessionScope.role=='CUSTOMER'}"><a class="btn btn-primary" href="${pageContext.request.contextPath}/feedback/new"><i class="bi bi-star"></i> Write review</a></c:if></div>
<div class="row g-4 mb-4"><div class="col-md-4"><div class="rating-summary panel h-100"><small>AVERAGE RATING</small><strong><fmt:formatNumber value="${feedbackAverage}" maxFractionDigits="1"/> <span>/ 5</span></strong><div class="stars"><c:forEach begin="1" end="5"><i class="bi bi-star-fill"></i></c:forEach></div><p>Based on <c:out value="${feedbackList.size()}"/> review(s) shown</p></div></div><div class="col-md-8"><div class="panel h-100"><div class="panel-header"><h2>Rating distribution</h2></div><div class="chart-wrap compact"><canvas id="ratingChart"></canvas></div></div></div></div>
<div class="panel"><form class="filter-bar flex-wrap" method="get" action="${pageContext.request.contextPath}/feedback/"><div class="search-field"><i class="bi bi-search"></i><input class="form-control" name="search" value="<c:out value='${param.search}'/>" placeholder="Order, customer or review"></div><select class="form-select" name="rating"><option value="">All ratings</option><c:forEach begin="1" end="5" var="star"><option value="${star}" ${param.rating==star?'selected':''}>${star} star${star==1?'':'s'}</option></c:forEach></select><c:if test="${sessionScope.role=='ADMINISTRATOR'}"><select class="form-select" name="status"><option value="">All moderation</option><c:forEach items="${['PENDING','APPROVED','HIDDEN']}" var="status"><option value="${status}" ${param.status==status?'selected':''}><c:out value="${status}"/></option></c:forEach></select></c:if><button class="btn btn-outline-primary">Filter</button><a class="btn btn-light" href="${pageContext.request.contextPath}/feedback/">Reset</a></form>
<c:choose><c:when test="${empty feedbackList}"><div class="empty-state"><i class="bi bi-chat-square-heart"></i><h3>No reviews found</h3><p>Completed orders can receive one customer review.</p></div></c:when><c:otherwise><div class="feedback-list"><c:forEach items="${feedbackList}" var="review"><article class="feedback-item"><div class="feedback-main"><div class="d-flex flex-wrap align-items-center gap-2"><strong><c:out value="${review.customerName}"/></strong><span class="stars"><c:forEach begin="1" end="${review.rating}"><i class="bi bi-star-fill"></i></c:forEach></span><span class="status-badge" data-status="${review.moderationStatus}"><c:out value="${review.moderationStatus}"/></span></div><p><c:out value="${review.comment}"/></p><small><c:out value="${review.orderNumber}"/> · <c:out value="${review.submittedAt}"/></small><c:if test="${not empty review.adminResponse}"><div class="admin-response"><strong>AquaClean response</strong><p><c:out value="${review.adminResponse}"/></p></div></c:if></div>
<div class="feedback-actions"><c:if test="${sessionScope.role=='CUSTOMER'}"><a class="btn btn-sm btn-light" href="${pageContext.request.contextPath}/feedback/edit?id=${review.id}"><i class="bi bi-pencil"></i> Edit</a><form method="post" action="${pageContext.request.contextPath}/feedback/" data-confirm="Delete this feedback permanently?"><input type="hidden" name="csrfToken" value="<c:out value='${sessionScope.csrfToken}'/>"><input type="hidden" name="action" value="delete"><input type="hidden" name="id" value="${review.id}"><button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button></form></c:if><c:if test="${sessionScope.role=='ADMINISTRATOR'}"><button class="btn btn-sm btn-outline-primary" type="button" data-bs-toggle="collapse" data-bs-target="#moderate-${review.id}">Moderate</button></c:if></div>
<c:if test="${sessionScope.role=='ADMINISTRATOR'}"><div class="collapse moderation-form" id="moderate-${review.id}"><form method="post" action="${pageContext.request.contextPath}/feedback/"><input type="hidden" name="csrfToken" value="<c:out value='${sessionScope.csrfToken}'/>"><input type="hidden" name="action" value="moderate"><input type="hidden" name="id" value="${review.id}"><div class="row g-2"><div class="col-md-3"><select class="form-select" name="status"><option value="PENDING" ${review.moderationStatus=='PENDING'?'selected':''}>Pending</option><option value="APPROVED" ${review.moderationStatus=='APPROVED'?'selected':''}>Approved</option><option value="HIDDEN" ${review.moderationStatus=='HIDDEN'?'selected':''}>Hidden</option></select></div><div class="col-md"><input class="form-control" name="adminResponse" value="<c:out value='${review.adminResponse}'/>" maxlength="1000" placeholder="Optional public response"></div><div class="col-md-auto"><button class="btn btn-primary">Save</button></div></div></form></div></c:if></article></c:forEach></div></c:otherwise></c:choose></div>
<script>document.addEventListener('DOMContentLoaded',()=>createBarChart('ratingChart',[<c:forEach items="${ratingDistribution}" var="entry" varStatus="loop">'${entry.key} star'${loop.last?'':','}</c:forEach>],[<c:forEach items="${ratingDistribution}" var="entry" varStatus="loop">${entry.value}${loop.last?'':','}</c:forEach>],'Reviews'));</script>
<jsp:include page="/WEB-INF/views/common/footer.jsp"/>
