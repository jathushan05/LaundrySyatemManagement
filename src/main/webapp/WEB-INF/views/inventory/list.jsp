<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %>
<c:set var="pageTitle" value="Inventory Management" scope="request"/><jsp:include page="/WEB-INF/views/common/header.jsp"/>
<div class="page-actions"><div><h1 class="page-heading">Inventory</h1><p>Monitor supplies, stock levels and usage.</p></div><div class="d-flex gap-2"><a class="btn btn-outline-primary" href="${pageContext.request.contextPath}/inventory/transactions"><i class="bi bi-clock-history"></i> History</a><a class="btn btn-primary" href="${pageContext.request.contextPath}/inventory/new"><i class="bi bi-plus-lg"></i> Add item</a></div></div>
<div class="panel"><form class="filter-bar flex-wrap" method="get" action="${pageContext.request.contextPath}/inventory/"><div class="search-field"><i class="bi bi-search"></i><input class="form-control" name="search" value="<c:out value='${param.search}'/>" placeholder="Code, item or supplier"></div><select class="form-select" name="category"><option value="">All categories</option><c:forEach items="${categories}" var="category"><option ${param.category==category?'selected':''}><c:out value="${category}"/></option></c:forEach></select><select class="form-select" name="status"><option value="">All statuses</option><option value="ACTIVE" ${param.status=='ACTIVE'?'selected':''}>Active</option><option value="INACTIVE" ${param.status=='INACTIVE'?'selected':''}>Inactive</option></select><label class="form-check"><input class="form-check-input" type="checkbox" name="low" value="1" ${param.low=='1'?'checked':''}><span>Low stock only</span></label><button class="btn btn-outline-primary">Filter</button><a class="btn btn-light" href="${pageContext.request.contextPath}/inventory/">Reset</a></form>
<c:choose><c:when test="${empty items}"><div class="empty-state"><i class="bi bi-box-seam"></i><h3>No inventory items found</h3><p>Adjust the filters or add a new supply item.</p></div></c:when><c:otherwise><div class="table-responsive"><table class="table align-middle"><thead><tr><th>Item</th><th>Category</th><th>Stock</th><th>Reorder at</th><th>Unit price</th><th>Status</th><th class="text-end">Actions</th></tr></thead><tbody><c:forEach items="${items}" var="item"><tr class="${item.lowStock?'low-stock-row':''}"><td><strong><c:out value="${item.itemName}"/></strong><br><small class="text-secondary"><c:out value="${item.inventoryCode}"/> · <c:out value="${item.supplier}"/></small></td><td><c:out value="${item.category}"/></td><td><strong><fmt:formatNumber value="${item.quantity}"/> <c:out value="${item.unit}"/></strong><c:if test="${item.lowStock}"><span class="low-stock-label"><i class="bi bi-exclamation-triangle-fill"></i> Low</span></c:if></td><td><fmt:formatNumber value="${item.reorderLevel}"/> <c:out value="${item.unit}"/></td><td>LKR <fmt:formatNumber value="${item.unitPrice}" minFractionDigits="2"/></td><td><span class="status-badge" data-status="${item.status}"><c:out value="${item.status}"/></span></td><td class="text-end"><div class="btn-group"><a class="btn btn-sm btn-light" href="${pageContext.request.contextPath}/inventory/view?id=${item.id}"><i class="bi bi-eye"></i></a><a class="btn btn-sm btn-light" href="${pageContext.request.contextPath}/inventory/edit?id=${item.id}"><i class="bi bi-pencil"></i></a><c:if test="${item.status=='ACTIVE'}"><form method="post" action="${pageContext.request.contextPath}/inventory/" data-confirm="Deactivate this inventory item?"><input type="hidden" name="csrfToken" value="<c:out value='${sessionScope.csrfToken}'/>"><input type="hidden" name="action" value="deactivate"><input type="hidden" name="id" value="${item.id}"><button class="btn btn-sm btn-light text-danger"><i class="bi bi-archive"></i></button></form></c:if></div></td></tr></c:forEach></tbody></table></div></c:otherwise></c:choose></div>
<jsp:include page="/WEB-INF/views/common/footer.jsp"/>
