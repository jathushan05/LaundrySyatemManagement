<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %>
<c:set var="pageTitle" value="Inventory Details" scope="request"/><jsp:include page="/WEB-INF/views/common/header.jsp"/>
<div class="page-actions"><div><h1 class="page-heading"><c:out value="${item.itemName}"/></h1><p><c:out value="${item.inventoryCode}"/> · <c:out value="${item.category}"/></p></div><div class="d-flex gap-2"><a class="btn btn-outline-primary" href="${pageContext.request.contextPath}/inventory/edit?id=${item.id}">Edit</a><a class="btn btn-light" href="${pageContext.request.contextPath}/inventory/">Back</a></div></div>
<div class="row g-4 mb-4"><div class="col-lg-4"><div class="panel h-100"><div class="stock-hero ${item.lowStock?'low':''}"><small>Current stock</small><strong><fmt:formatNumber value="${item.quantity}"/> <c:out value="${item.unit}"/></strong><c:if test="${item.lowStock}"><span><i class="bi bi-exclamation-triangle-fill"></i> Reorder required</span></c:if></div><dl class="detail-list"><dt>Reorder level</dt><dd><fmt:formatNumber value="${item.reorderLevel}"/> <c:out value="${item.unit}"/></dd><dt>Unit price</dt><dd>LKR <fmt:formatNumber value="${item.unitPrice}" minFractionDigits="2"/></dd><dt>Supplier</dt><dd><c:out value="${empty item.supplier?'—':item.supplier}"/></dd><dt>Last updated</dt><dd><c:out value="${item.lastUpdated}"/></dd></dl></div></div>
<div class="col-lg-8"><div class="panel h-100"><div class="panel-header"><h2>Record stock transaction</h2></div><form method="post" action="${pageContext.request.contextPath}/inventory/" class="needs-validation" novalidate><input type="hidden" name="csrfToken" value="<c:out value='${sessionScope.csrfToken}'/>"><input type="hidden" name="action" value="transaction"><input type="hidden" name="id" value="${item.id}"><div class="row g-3"><div class="col-md-4"><label class="form-label">Type *</label><select class="form-select" name="type" id="stockType" required><option value="STOCK_IN">Stock addition</option><option value="USAGE">Order usage</option><option value="ADJUSTMENT">Set actual balance</option></select></div><div class="col-md-4"><label class="form-label">Quantity *</label><input class="form-control" name="quantity" type="number" min="0.01" step="0.01" required></div><div class="col-md-4"><label class="form-label">Related order</label><select class="form-select" name="orderId" id="stockOrder"><option value="">None</option><c:forEach items="${orders}" var="order"><option value="${order.id}"><c:out value="${order.orderNumber}"/></option></c:forEach></select></div><div class="col-12"><label class="form-label">Notes</label><textarea class="form-control" name="notes" maxlength="300" rows="2"></textarea></div><div class="col-12 text-end"><button class="btn btn-primary">Record transaction</button></div></div></form></div></div></div>
<div class="panel"><div class="panel-header"><h2>Transaction history</h2><a href="${pageContext.request.contextPath}/inventory/transactions">All transactions</a></div><c:choose><c:when test="${empty transactions}"><div class="empty-state"><p>No stock transactions recorded.</p></div></c:when><c:otherwise><div class="table-responsive"><table class="table align-middle"><thead><tr><th>Date</th><th>Type</th><th>Quantity</th><th>Balance after</th><th>Order</th><th>Notes</th></tr></thead><tbody><c:forEach items="${transactions}" var="tx"><tr><td><c:out value="${tx.createdAt}"/></td><td><span class="status-badge" data-status="${tx.transactionType}"><c:out value="${tx.transactionType}"/></span></td><td><fmt:formatNumber value="${tx.quantity}"/></td><td><fmt:formatNumber value="${tx.balanceAfter}"/></td><td><c:out value="${empty tx.orderId?'—':tx.orderId}"/></td><td><c:out value="${tx.notes}"/></td></tr></c:forEach></tbody></table></div></c:otherwise></c:choose></div>
<jsp:include page="/WEB-INF/views/common/footer.jsp"/>
