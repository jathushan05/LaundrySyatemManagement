<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %>
<c:set var="pageTitle" value="Stock Transaction History" scope="request"/><jsp:include page="/WEB-INF/views/common/header.jsp"/>
<div class="page-actions"><div><h1 class="page-heading">Stock history</h1><p>Audit all additions, usage and balance adjustments.</p></div><a class="btn btn-light" href="${pageContext.request.contextPath}/inventory/">Back</a></div><div class="panel"><c:choose><c:when test="${empty transactions}"><div class="empty-state"><i class="bi bi-clock-history"></i><p>No transactions have been recorded.</p></div></c:when><c:otherwise><div class="table-responsive"><table class="table align-middle"><thead><tr><th>Date</th><th>Item</th><th>Type</th><th>Quantity</th><th>Balance</th><th>Order ID</th><th>Notes</th></tr></thead><tbody><c:forEach items="${transactions}" var="tx"><tr><td><c:out value="${tx.createdAt}"/></td><td><strong><c:out value="${tx.itemName}"/></strong></td><td><span class="status-badge" data-status="${tx.transactionType}"><c:out value="${tx.transactionType}"/></span></td><td><fmt:formatNumber value="${tx.quantity}"/></td><td><fmt:formatNumber value="${tx.balanceAfter}"/></td><td><c:out value="${empty tx.orderId?'—':tx.orderId}"/></td><td><c:out value="${tx.notes}"/></td></tr></c:forEach></tbody></table></div></c:otherwise></c:choose></div>
<jsp:include page="/WEB-INF/views/common/footer.jsp"/>
