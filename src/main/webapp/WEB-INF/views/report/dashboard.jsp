<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %>
<c:set var="pageTitle" value="Reports & Analytics" scope="request"/><jsp:include page="/WEB-INF/views/common/header.jsp"/>
<nav class="report-tabs d-print-none" aria-label="Report views"><a class="active" href="${pageContext.request.contextPath}/reports">Analytics overview</a><a href="${pageContext.request.contextPath}/reports/manage">Saved reports</a></nav>
<c:if test="${not empty savedReport}"><div class="saved-report-banner"><div><span class="section-label">SAVED REPORT / RPT-${savedReport.id}</span><h1 class="h4"><c:out value="${savedReport.title}"/></h1><p class="report-period mb-1"><i class="bi bi-calendar-range me-1"></i><c:out value="${savedReport.fromDate}"/> to <c:out value="${savedReport.toDate}"/> &middot; <c:out value="${empty savedReport.orderStatus ? 'All statuses' : savedReport.orderStatus}"/></p><p class="report-notes"><c:out value="${savedReport.notes}"/></p></div><a class="btn btn-outline-primary d-print-none" href="${pageContext.request.contextPath}/reports/manage?action=edit&amp;id=${savedReport.id}"><i class="bi bi-pencil"></i> Edit report</a></div></c:if>
<div class="page-actions"><div><h1 class="page-heading">Reports & analytics</h1><p>Review revenue, services, inventory, delivery and customer experience.</p></div><button class="btn btn-outline-primary" type="button" onclick="window.print()"><i class="bi bi-printer"></i> Print report</button></div>
<div class="panel mb-4 d-print-none"><div class="panel-header"><div><h2>Report type</h2><small>Generate a regular order report or a monthly performance report.</small></div></div><div class="row g-3 p-3 pt-0"><div class="col-lg-5"><div class="border rounded-3 p-3 h-100"><strong><i class="bi bi-list-check me-1"></i> Regular / Custom Order Report</strong><p class="small text-secondary mb-0 mt-1">Filter individual orders by date range and status.</p></div></div><div class="col-lg-7"><form class="row g-2 align-items-end" method="get" action="${pageContext.request.contextPath}/reports"><div class="col-sm-5"><label class="form-label small">From</label><input class="form-control" name="from" type="date" value="<c:out value='${rangeFrom}'/>"></div><div class="col-sm-5"><label class="form-label small">To</label><input class="form-control" name="to" type="date" value="<c:out value='${rangeTo}'/>"></div><div class="col-sm-2"><button class="btn btn-primary w-100">Apply</button></div><div class="col-sm-5"><label class="form-label small">Status</label><select class="form-select" name="status"><option value="">All statuses</option><c:forEach items="${['RECEIVED','WASHING','PROCESSING','READY','COMPLETED','DELIVERED','CANCELLED']}" var="status"><option value="${status}" ${rangeStatus==status?'selected':''}><c:out value="${status}"/></option></c:forEach></select></div><div class="col-sm-5"><label class="form-label small">Monthly report</label><input class="form-control" id="reportMonth" type="month"></div><div class="col-sm-2"><button class="btn btn-outline-primary w-100" type="button" onclick="applyMonthlyReport()">Month</button></div><div class="col-12"><a class="btn btn-light btn-sm" href="${pageContext.request.contextPath}/reports">Reset filters</a></div></form></div></div></div>
<section class="finance-summary" aria-label="Financial summary">
<div class="finance-head"><div><h2>Financial summary</h2><small><i class="bi bi-calendar-range me-1"></i><c:choose><c:when test="${empty rangeFrom && empty rangeTo}">All dates</c:when><c:otherwise><c:out value="${empty rangeFrom ? 'Beginning' : rangeFrom}"/> to <c:out value="${empty rangeTo ? 'today' : rangeTo}"/></c:otherwise></c:choose><c:if test="${not empty rangeStatus}"> &middot; <c:out value="${rangeStatus}"/> orders</c:if></small></div></div>
<div class="finance-grid">
<div class="finance-card credit"><span class="finance-icon"><i class="bi bi-arrow-down-left"></i></span><div><small>Credit &middot; money in</small><strong>LKR <fmt:formatNumber value="${finance.credit}" minFractionDigits="2" maxFractionDigits="2"/></strong><em>${finance.paidOrders} completed/delivered order(s) &middot; services LKR <fmt:formatNumber value="${finance.serviceRevenue}" minFractionDigits="2" maxFractionDigits="2"/> + delivery LKR <fmt:formatNumber value="${finance.deliveryCharges}" minFractionDigits="2" maxFractionDigits="2"/></em></div></div>
<div class="finance-card debit"><span class="finance-icon"><i class="bi bi-arrow-up-right"></i></span><div><small>Debit &middot; money out</small><strong>LKR <fmt:formatNumber value="${finance.debit}" minFractionDigits="2" maxFractionDigits="2"/></strong><em>Inventory stock purchased in this period</em></div></div>
<div class="finance-card net ${finance.net.signum() < 0 ? 'negative' : ''}"><span class="finance-icon"><i class="bi bi-wallet2"></i></span><div><small>${finance.net.signum() < 0 ? 'Net loss' : 'Net profit'} &middot; credit &minus; debit</small><strong>LKR <fmt:formatNumber value="${finance.net}" minFractionDigits="2" maxFractionDigits="2"/></strong><em>Revenue minus stock purchases</em></div></div>
</div>
<div class="panel finance-ledger"><div class="panel-header"><h2>Debit &middot; stock purchases</h2><span><c:out value="${finance.purchases.size()}"/> item(s)</span></div>
<c:choose><c:when test="${empty finance.purchases}"><div class="empty-state"><p>No stock was purchased in this period.</p></div></c:when><c:otherwise><div class="table-responsive"><table class="table"><thead><tr><th>Item</th><th class="text-end">Quantity in</th><th class="text-end">Unit price</th><th class="text-end">Amount</th></tr></thead><tbody><c:forEach items="${finance.purchases}" var="line"><tr><td><c:out value="${line.itemName}"/></td><td class="text-end"><fmt:formatNumber value="${line.quantity}"/> <c:out value="${line.unit}"/></td><td class="text-end">LKR <fmt:formatNumber value="${line.unitPrice}" minFractionDigits="2" maxFractionDigits="2"/></td><td class="text-end">LKR <fmt:formatNumber value="${line.amount}" minFractionDigits="2" maxFractionDigits="2"/></td></tr></c:forEach></tbody><tfoot><tr><th colspan="3" class="text-end">Total debit</th><th class="text-end">LKR <fmt:formatNumber value="${finance.debit}" minFractionDigits="2" maxFractionDigits="2"/></th></tr></tfoot></table></div></c:otherwise></c:choose>
<p class="finance-note">Credit counts completed and delivered orders only (cancelled and in-progress orders are not revenue). Debit uses stock-in records valued at each item&rsquo;s current unit price.</p></div>
</section>
<p class="text-secondary small">Overview: all-time totals, current active deliveries, and revenue for the last six months. The range below filters operational tables and service popularity; order status applies to the order table.</p>
<div class="row g-3 mb-4"><div class="col-6 col-xl-3"><div class="stat-card"><span class="stat-icon blue"><i class="bi bi-cash-stack"></i></span><div><small>Total revenue</small><strong class="money">LKR <fmt:formatNumber value="${stats.totalRevenue}" maxFractionDigits="0"/></strong></div></div></div><div class="col-6 col-xl-3"><div class="stat-card"><span class="stat-icon green"><i class="bi bi-check-circle"></i></span><div><small>Completed</small><strong>${stats.completedOrders}</strong></div></div></div><div class="col-6 col-xl-3"><div class="stat-card"><span class="stat-icon amber"><i class="bi bi-star-fill"></i></span><div><small>Average rating (overall)</small><strong><fmt:formatNumber value="${stats.averageRating}" maxFractionDigits="1"/> / 5</strong></div></div></div><div class="col-6 col-xl-3"><div class="stat-card"><span class="stat-icon indigo"><i class="bi bi-truck"></i></span><div><small>Active deliveries</small><strong>${rangeActiveDeliveries}</strong></div></div></div></div>
<div class="row g-4 mb-4"><div class="col-lg-8"><div class="panel"><div class="panel-header"><div><h2>Monthly revenue</h2><small>Completed and delivered order value</small></div></div><div class="chart-wrap"><canvas id="reportRevenue"></canvas></div></div></div><div class="col-lg-4"><div class="panel"><div class="panel-header"><h2>Orders by status</h2></div><div class="chart-wrap"><canvas id="reportStatus"></canvas></div></div></div></div>
<div class="row g-4 mb-4"><div class="col-lg-6"><div class="panel"><div class="panel-header"><h2>Popular laundry services</h2></div><div class="chart-wrap"><canvas id="serviceChart"></canvas></div></div></div><div class="col-lg-6"><div class="panel"><div class="panel-header"><h2>Customer rating distribution</h2></div><div class="chart-wrap"><canvas id="reportRating"></canvas></div></div></div></div>
<div class="row g-4 mb-4"><div class="col-lg-6"><div class="panel"><div class="panel-header"><h2>Inventory usage</h2></div><c:choose><c:when test="${empty inventoryUsage}"><div class="empty-state"><p>No usage in this period.</p></div></c:when><c:otherwise><table class="table"><thead><tr><th>Item</th><th class="text-end">Quantity used</th></tr></thead><tbody><c:forEach items="${inventoryUsage}" var="entry"><tr><td><c:out value="${entry.key}"/></td><td class="text-end"><fmt:formatNumber value="${entry.value}"/></td></tr></c:forEach></tbody></table></c:otherwise></c:choose></div></div><div class="col-lg-6"><div class="panel"><div class="panel-header"><h2>Pickup & delivery performance</h2></div><c:choose><c:when test="${empty deliveryPerformance}"><div class="empty-state"><p>No deliveries in this period.</p></div></c:when><c:otherwise><table class="table"><thead><tr><th>Status</th><th class="text-end">Requests</th></tr></thead><tbody><c:forEach items="${deliveryPerformance}" var="entry"><tr><td><span class="status-badge" data-status="${entry.key}"><c:out value="${entry.key}"/></span></td><td class="text-end"><c:out value="${entry.value}"/></td></tr></c:forEach></tbody></table></c:otherwise></c:choose></div></div></div>
<div class="panel mb-4"><div class="panel-header"><div><h2>Monthly Performance Report</h2><small>Business-level summary for the selected month</small></div></div><div class="row g-3 p-3"><div class="col-md-3"><div class="stat-card h-100"><span class="stat-icon blue"><i class="bi bi-box-seam"></i></span><div><small>Orders in period</small><strong>${rangeOrderCount}</strong></div></div></div><div class="col-md-3"><div class="stat-card h-100"><span class="stat-icon green"><i class="bi bi-check-circle"></i></span><div><small>Completed / delivered</small><strong>${rangeCompleted}</strong></div></div></div><div class="col-md-3"><div class="stat-card h-100"><span class="stat-icon indigo"><i class="bi bi-truck"></i></span><div><small>Active deliveries</small><strong>${stats.scheduledDeliveries}</strong></div></div></div><div class="col-md-3"><div class="stat-card h-100"><span class="stat-icon amber"><i class="bi bi-star-fill"></i></span><div><small>Average rating</small><strong><fmt:formatNumber value="${stats.averageRating}" maxFractionDigits="1"/> / 5</strong></div></div></div></div><div class="table-responsive"><table class="table mb-0"><thead><tr><th>Monthly Analysis</th><th>Result</th></tr></thead><tbody><tr><td>Total revenue in period</td><td>LKR <fmt:formatNumber value="${rangeRevenue}" minFractionDigits="2"/></td></tr><tr><td>Orders by status</td><td><c:forEach items="${rangeStatusCounts}" var="entry" varStatus="loop"><c:out value="${entry.key}"/>: ${entry.value}<c:if test="${!loop.last}"> &middot; </c:if></c:forEach></td></tr><tr><td>Popular laundry services</td><td><c:forEach items="${popularServices}" var="entry" varStatus="loop"><c:out value="${entry.key}"/>: ${entry.value}<c:if test="${!loop.last}"> &middot; </c:if></c:forEach></td></tr><tr><td>Inventory usage</td><td><c:forEach items="${inventoryUsage}" var="entry" varStatus="loop"><c:out value="${entry.key}"/>: <fmt:formatNumber value="${entry.value}" maxFractionDigits="2"/><c:if test="${!loop.last}"> &middot; </c:if></c:forEach></td></tr><tr><td>Delivery performance</td><td><c:forEach items="${deliveryPerformance}" var="entry" varStatus="loop"><c:out value="${entry.key}"/>: ${entry.value}<c:if test="${!loop.last}"> &middot; </c:if></c:forEach></td></tr><tr><td>Financial summary</td><td>Credit: LKR <fmt:formatNumber value="${finance.credit}" maxFractionDigits="2"/> &middot; Debit: LKR <fmt:formatNumber value="${finance.debit}" maxFractionDigits="2"/> &middot; Net: LKR <fmt:formatNumber value="${finance.net}" maxFractionDigits="2"/></td></tr></tbody></table></div></div><div class="panel mb-4"><div class="panel-header"><div><h2>Regular Order Report</h2><small>Detailed orders for the selected date range</small></div><span>${orders.size()} record(s)</span></div><c:choose><c:when test="${empty orders}"><div class="empty-state"><p>No orders match this report range.</p></div></c:when><c:otherwise><div class="table-responsive"><table class="table align-middle"><thead><tr><th>Order ID</th><th>Customer</th><th>Service / Items</th><th>Qty</th><th>Date Created</th><th>Expected Completion</th><th>Status</th><th class="text-end">Amount</th></tr></thead><tbody><c:forEach items="${orders}" var="order"><tr><td><strong><c:out value="${order.orderNumber}"/></strong></td><td><c:out value="${order.customerName}"/></td><td><c:out value="${empty order.serviceNames ? '—' : order.serviceNames}"/></td><td><c:out value="${order.totalQuantity}"/></td><td><c:out value="${order.receivedAt.toLocalDate()}"/></td><td><c:out value="${empty order.expectedCompletionDate ? '—' : order.expectedCompletionDate}"/></td><td><span class="status-badge" data-status="${order.status}"><c:out value="${order.status}"/></span></td><td class="text-end">LKR <fmt:formatNumber value="${order.totalAmount}" minFractionDigits="2"/></td></tr></c:forEach></tbody></table></div></c:otherwise></c:choose></div>
<div class="panel"><div class="panel-header"><h2>Low-stock items</h2><a class="d-print-none" href="${pageContext.request.contextPath}/inventory/?low=1">Manage inventory</a></div><c:choose><c:when test="${empty lowStock}"><div class="empty-state"><p>All active inventory is above its reorder level.</p></div></c:when><c:otherwise><div class="table-responsive"><table class="table"><thead><tr><th>Item</th><th>Current</th><th>Reorder level</th><th>Supplier</th></tr></thead><tbody><c:forEach items="${lowStock}" var="item"><tr><td><strong><c:out value="${item.itemName}"/></strong></td><td class="text-danger"><fmt:formatNumber value="${item.quantity}"/> <c:out value="${item.unit}"/></td><td><fmt:formatNumber value="${item.reorderLevel}"/> <c:out value="${item.unit}"/></td><td><c:out value="${item.supplier}"/></td></tr></c:forEach></tbody></table></div></c:otherwise></c:choose></div>
<script>document.addEventListener('DOMContentLoaded',()=>{createLineChart('reportRevenue',[<c:forEach items="${stats.monthlyRevenueChart}" var="e" varStatus="s">'<c:out value="${e.key}"/>'${s.last?'':','}</c:forEach>],[<c:forEach items="${stats.monthlyRevenueChart}" var="e" varStatus="s">${e.value}${s.last?'':','}</c:forEach>],'Revenue (LKR)');createDoughnutChart('reportStatus',[<c:forEach items="${stats.orderStatusChart}" var="e" varStatus="s">'<c:out value="${e.key}"/>'${s.last?'':','}</c:forEach>],[<c:forEach items="${stats.orderStatusChart}" var="e" varStatus="s">${e.value}${s.last?'':','}</c:forEach>]);createBarChart('serviceChart',[<c:forEach items="${popularServices}" var="e" varStatus="s">'<c:out value="${e.key}"/>'${s.last?'':','}</c:forEach>],[<c:forEach items="${popularServices}" var="e" varStatus="s">${e.value}${s.last?'':','}</c:forEach>],'Items');createBarChart('reportRating',[<c:forEach items="${stats.ratingChart}" var="e" varStatus="s">'${e.key} star'${s.last?'':','}</c:forEach>],[<c:forEach items="${stats.ratingChart}" var="e" varStatus="s">${e.value}${s.last?'':','}</c:forEach>],'Reviews');});function applyMonthlyReport(){const v=document.getElementById('reportMonth').value;if(!v)return;const f=document.querySelector('input[name="from"]');const t=document.querySelector('input[name="to"]');f.value=v+'-01';const d=new Date(Number(v.slice(0,4)),Number(v.slice(5,7)),0);t.value=v+'-'+String(d.getDate()).padStart(2,'0');document.querySelector('.filter-bar, form.row').submit();}
</script>
<jsp:include page="/WEB-INF/views/common/footer.jsp"/>
