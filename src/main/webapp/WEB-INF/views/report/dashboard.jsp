<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %>
<c:set var="pageTitle" value="Reports & Analytics" scope="request"/><jsp:include page="/WEB-INF/views/common/header.jsp"/>
<nav class="report-tabs d-print-none" aria-label="Report views"><a class="active" href="${pageContext.request.contextPath}/reports">Analytics overview</a><a href="${pageContext.request.contextPath}/reports/manage">Saved reports</a></nav>
<c:if test="${not empty savedReport}"><div class="saved-report-banner"><div><span class="section-label">SAVED REPORT / RPT-${savedReport.id}</span><h1 class="h4"><c:out value="${savedReport.title}"/></h1><p class="report-notes"><c:out value="${savedReport.notes}"/></p></div><a class="btn btn-outline-primary d-print-none" href="${pageContext.request.contextPath}/reports/manage?action=edit&amp;id=${savedReport.id}"><i class="bi bi-pencil"></i> Edit report</a></div></c:if>
<div class="page-actions"><div><h1 class="page-heading">Reports & analytics</h1><p>Review revenue, services, inventory, delivery and customer experience.</p></div><button class="btn btn-outline-primary" type="button" onclick="window.print()"><i class="bi bi-printer"></i> Print report</button></div>
<div class="panel mb-4 d-print-none"><form class="filter-bar" method="get" action="${pageContext.request.contextPath}/reports"><div><label class="form-label small">From</label><input class="form-control" name="from" type="date" value="<c:out value='${rangeFrom}'/>"></div><div><label class="form-label small">To</label><input class="form-control" name="to" type="date" value="<c:out value='${rangeTo}'/>"></div><div><label class="form-label small">Order status</label><select class="form-select" name="status"><option value="">All statuses</option><c:forEach items="${['RECEIVED','WASHING','PROCESSING','READY','COMPLETED','DELIVERED','CANCELLED']}" var="status"><option value="${status}" ${rangeStatus==status?'selected':''}><c:out value="${status}"/></option></c:forEach></select></div><button class="btn btn-primary align-self-end">Apply range</button><a class="btn btn-light align-self-end" href="${pageContext.request.contextPath}/reports">Reset</a></form></div>
<p class="text-secondary small">Overview: all-time totals, current active deliveries, and revenue for the last six months. The range below filters operational tables and service popularity; order status applies to the order table.</p>
<div class="row g-3 mb-4"><div class="col-6 col-xl-3"><div class="stat-card"><span class="stat-icon blue"><i class="bi bi-cash-stack"></i></span><div><small>Total revenue</small><strong class="money">LKR <fmt:formatNumber value="${stats.totalRevenue}" maxFractionDigits="0"/></strong></div></div></div><div class="col-6 col-xl-3"><div class="stat-card"><span class="stat-icon green"><i class="bi bi-check-circle"></i></span><div><small>Completed</small><strong>${stats.completedOrders}</strong></div></div></div><div class="col-6 col-xl-3"><div class="stat-card"><span class="stat-icon amber"><i class="bi bi-star-fill"></i></span><div><small>Average rating</small><strong><fmt:formatNumber value="${stats.averageRating}" maxFractionDigits="1"/> / 5</strong></div></div></div><div class="col-6 col-xl-3"><div class="stat-card"><span class="stat-icon indigo"><i class="bi bi-truck"></i></span><div><small>Active deliveries</small><strong>${stats.scheduledDeliveries}</strong></div></div></div></div>
<div class="row g-4 mb-4"><div class="col-lg-8"><div class="panel"><div class="panel-header"><div><h2>Monthly revenue</h2><small>Completed and delivered order value</small></div></div><div class="chart-wrap"><canvas id="reportRevenue"></canvas></div></div></div><div class="col-lg-4"><div class="panel"><div class="panel-header"><h2>Orders by status</h2></div><div class="chart-wrap"><canvas id="reportStatus"></canvas></div></div></div></div>
<div class="row g-4 mb-4"><div class="col-lg-6"><div class="panel"><div class="panel-header"><h2>Popular laundry services</h2></div><div class="chart-wrap"><canvas id="serviceChart"></canvas></div></div></div><div class="col-lg-6"><div class="panel"><div class="panel-header"><h2>Customer rating distribution</h2></div><div class="chart-wrap"><canvas id="reportRating"></canvas></div></div></div></div>
<div class="row g-4 mb-4"><div class="col-lg-6"><div class="panel"><div class="panel-header"><h2>Inventory usage</h2></div><c:choose><c:when test="${empty inventoryUsage}"><div class="empty-state"><p>No usage in this period.</p></div></c:when><c:otherwise><table class="table"><thead><tr><th>Item</th><th class="text-end">Quantity used</th></tr></thead><tbody><c:forEach items="${inventoryUsage}" var="entry"><tr><td><c:out value="${entry.key}"/></td><td class="text-end"><fmt:formatNumber value="${entry.value}"/></td></tr></c:forEach></tbody></table></c:otherwise></c:choose></div></div><div class="col-lg-6"><div class="panel"><div class="panel-header"><h2>Pickup & delivery performance</h2></div><c:choose><c:when test="${empty deliveryPerformance}"><div class="empty-state"><p>No deliveries in this period.</p></div></c:when><c:otherwise><table class="table"><thead><tr><th>Status</th><th class="text-end">Requests</th></tr></thead><tbody><c:forEach items="${deliveryPerformance}" var="entry"><tr><td><span class="status-badge" data-status="${entry.key}"><c:out value="${entry.key}"/></span></td><td class="text-end"><c:out value="${entry.value}"/></td></tr></c:forEach></tbody></table></c:otherwise></c:choose></div></div></div>
<div class="panel mb-4"><div class="panel-header"><h2>Orders in selected range</h2><span>${orders.size()} record(s)</span></div><c:choose><c:when test="${empty orders}"><div class="empty-state"><p>No orders match this report range.</p></div></c:when><c:otherwise><div class="table-responsive"><table class="table"><thead><tr><th>Order</th><th>Customer</th><th>Date</th><th>Status</th><th class="text-end">Revenue</th></tr></thead><tbody><c:forEach items="${orders}" var="order"><tr><td><c:out value="${order.orderNumber}"/></td><td><c:out value="${order.customerName}"/></td><td><c:out value="${order.receivedAt.toLocalDate()}"/></td><td><span class="status-badge" data-status="${order.status}"><c:out value="${order.status}"/></span></td><td class="text-end">LKR <fmt:formatNumber value="${order.totalAmount}" minFractionDigits="2"/></td></tr></c:forEach></tbody></table></div></c:otherwise></c:choose></div>
<div class="panel"><div class="panel-header"><h2>Low-stock items</h2><a class="d-print-none" href="${pageContext.request.contextPath}/inventory/?low=1">Manage inventory</a></div><c:choose><c:when test="${empty lowStock}"><div class="empty-state"><p>All active inventory is above its reorder level.</p></div></c:when><c:otherwise><div class="table-responsive"><table class="table"><thead><tr><th>Item</th><th>Current</th><th>Reorder level</th><th>Supplier</th></tr></thead><tbody><c:forEach items="${lowStock}" var="item"><tr><td><strong><c:out value="${item.itemName}"/></strong></td><td class="text-danger"><fmt:formatNumber value="${item.quantity}"/> <c:out value="${item.unit}"/></td><td><fmt:formatNumber value="${item.reorderLevel}"/> <c:out value="${item.unit}"/></td><td><c:out value="${item.supplier}"/></td></tr></c:forEach></tbody></table></div></c:otherwise></c:choose></div>
<script>document.addEventListener('DOMContentLoaded',()=>{createLineChart('reportRevenue',[<c:forEach items="${stats.monthlyRevenueChart}" var="e" varStatus="s">'<c:out value="${e.key}"/>'${s.last?'':','}</c:forEach>],[<c:forEach items="${stats.monthlyRevenueChart}" var="e" varStatus="s">${e.value}${s.last?'':','}</c:forEach>],'Revenue (LKR)');createDoughnutChart('reportStatus',[<c:forEach items="${stats.orderStatusChart}" var="e" varStatus="s">'<c:out value="${e.key}"/>'${s.last?'':','}</c:forEach>],[<c:forEach items="${stats.orderStatusChart}" var="e" varStatus="s">${e.value}${s.last?'':','}</c:forEach>]);createBarChart('serviceChart',[<c:forEach items="${popularServices}" var="e" varStatus="s">'<c:out value="${e.key}"/>'${s.last?'':','}</c:forEach>],[<c:forEach items="${popularServices}" var="e" varStatus="s">${e.value}${s.last?'':','}</c:forEach>],'Items');createBarChart('reportRating',[<c:forEach items="${stats.ratingChart}" var="e" varStatus="s">'${e.key} star'${s.last?'':','}</c:forEach>],[<c:forEach items="${stats.ratingChart}" var="e" varStatus="s">${e.value}${s.last?'':','}</c:forEach>],'Reviews');});</script>
<jsp:include page="/WEB-INF/views/common/footer.jsp"/>
